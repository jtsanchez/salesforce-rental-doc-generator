<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Bond_Weeks__c</fullName>
    <description>Calculated: bond expressed as weeks of rent.</description>
    <externalId>false</externalId>
    <formula>IF( Weekly_Rent__c &gt; 0, Bond_Amount__c / Weekly_Rent__c, 0 )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Bond (weeks of rent)</label>
    <precision>4</precision>
    <scale>1</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
